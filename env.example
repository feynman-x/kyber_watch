# KyberSwap Earn API base URL
KYBER_EARN_API_BASE_URL=https://earn-service.kyberswap.com/api/v1/explorer/pools

# Optional comma-separated DNS servers used for KyberSwap API requests
DNS_SERVERS=

# Comma-separated chain IDs (default: 8453,56)
KYBER_CHAIN_IDS=8453,56

# Number of pages to fetch (default: 5)
POOL_PAGES=5

# Page size per request (default: 10)
POOL_LIMIT=10

# Minimum APR filter (default: 0)
POOL_MIN_APR=0

# Minimum earn fee filter (default: 0)
POOL_MIN_EARN_FEE=0

# Minimum volume filter (default: 0)
POOL_MIN_VOLUME=0

# Telegram bot token and chat ID for notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional Telegram topic ID for pool monitor notifications
POOL_MONITOR_TELEGRAM_MESSAGE_THREAD_ID=

# Notification cooldown per pool in ms (default: 259200000)
POOL_NOTIFY_COOLDOWN_MS=259200000

# File path to persist notification timestamps (default: data/pool-notify.json)
POOL_NOTIFY_STORE_PATH=data/pool-notify.json

# Kyber positions API base URL
KYBER_POSITIONS_API_BASE_URL=https://earn-service.kyberswap.com/api/v1/positions

# Optional filters for LP monitor
LP_MONITOR_CHAIN_IDS=
LP_MONITOR_PROTOCOLS=
LP_MONITOR_STATUSES=PositionStatusInRange,PositionStatusOutRange

# Positions API page size (default: 20)
LP_MONITOR_PAGE_SIZE=20

# Optional Telegram topic ID for LP monitor notifications
LP_MONITOR_TELEGRAM_MESSAGE_THREAD_ID=

# File path to persist watched LP addresses (default: data/lp-monitor-addresses.json)
LP_MONITOR_STORE_PATH=data/lp-monitor-addresses.json

# OKX Onchain OS API credentials
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# Optional OKX API settings
OKX_API_BASE_URL=https://web3.okx.com
OKX_REQUEST_TIMEOUT_MS=15000
OKX_MIN_REQUEST_INTERVAL_MS=1100

# Optional comma-separated DNS servers used only for OKX API requests.
# Falls back to DNS_SERVERS when empty or omitted.
OKX_DNS_SERVERS=
